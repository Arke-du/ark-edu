SECRET_KEY=gere-uma-chave-aleatoria-longa
LGPD_ENCRYPTION_KEY=gere-com-python-gerar_chaves_lgpd.py
CPF_HASH_KEY=gere-uma-chave-secreta-longa
SESSION_COOKIE_SECURE=true
SESSION_TIMEOUT_MINUTES=30
TERMOS_VERSAO=1.0
PRIVACIDADE_VERSAO=1.0
CANAL_PRIVACIDADE=privacidade@arkedus.com.br

# Backups automáticos
BACKUP_AUTOMATICO=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=3
BACKUP_INCLUDE_UPLOADS=false
# No Render, aponte para um Persistent Disk, por exemplo: /var/data/backups
BACKUP_DIR=backups
# Opcional: chave Fernet para criptografar os arquivos de backup
# BACKUP_ENCRYPTION_KEY=

# ===== ARK IA - GOOGLE GEMINI =====
# Crie a chave no Google AI Studio e configure no Render. Nunca coloque a chave no código.
GEMINI_API_KEY=
# Modelos opcionais. O padrão da aplicação é gemini-3.6-flash.
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash

# ===== ARMAZENAMENTO PERSISTENTE (RENDER) =====
# Configure um Persistent Disk com Mount Path /var/data.
DATABASE_PATH=/var/data/plataforma.db
UPLOAD_FOLDER=/var/data/uploads
BACKUP_DIR=/var/data/backups
RENDER_DISK_PATH=/var/data

# ===== PAGAMENTOS ASAAS =====
# Em produção, use ASAAS_ENV=production. Para testes sem cobrança real: sandbox.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token secreto configurado também no webhook do painel Asaas.
ASAAS_WEBHOOK_TOKEN=
# Opcional. Sobrescreve a URL da API (normalmente não é necessário).
# ASAAS_API_URL=https://api-sandbox.asaas.com/v3
