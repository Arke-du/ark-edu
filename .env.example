SECRET_KEY=gere-uma-chave-aleatoria-longa
LGPD_ENCRYPTION_KEY=gere-com-python-gerar_chaves_lgpd.py
CPF_HASH_KEY=gere-uma-chave-secreta-longa
SESSION_COOKIE_SECURE=true
SESSION_TIMEOUT_MINUTES=30
TERMOS_VERSAO=1.0
PRIVACIDADE_VERSAO=1.0
CANAL_PRIVACIDADE=privacidade@arkedus.com.br

# Backups automáticos
BACKUP_AUTOMATICO=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_INCLUDE_UPLOADS=true
# No Render, aponte para um Persistent Disk, por exemplo: /var/data/backups
BACKUP_DIR=backups
# Opcional: chave Fernet para criptografar os arquivos de backup
# BACKUP_ENCRYPTION_KEY=

# Importação de questão por foto/print (IA com visão)
# Configure esta variável no Render; nunca coloque a chave diretamente no código.
OPENAI_API_KEY=
# Modelo de visão (opcional)
OPENAI_VISION_MODEL=gpt-5.6-luna
